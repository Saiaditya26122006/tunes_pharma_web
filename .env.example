# Copy this file to .env and fill in your values
# Never commit .env to git

# Flask
SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=false

# JWT (for doctor API auth — set a strong random string, different from SECRET_KEY)
JWT_SECRET_KEY=change-this-to-a-different-random-string

# CORS (comma-separated origins for API clients, e.g. your React Native app URL)
# Leave empty to disable CORS
CORS_ORIGINS=

# Base URL (used for sitemap, robots.txt, etc.)
BASE_URL=https://tunespharma.org

# Supabase (Settings > API in your Supabase dashboard)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Admin panel password (legacy — kept during migration to admin_users table)
ADMIN_PASSWORD=your-admin-password-here

# Gmail SMTP (for email notifications)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenAI (for Pharmaintel AI page)
OPENAI_API_KEY=your-openai-api-key-here

# Push notifications (VAPID keys — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@tunespharma.org

# SMS (Twilio)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# WhatsApp Business API (Meta)
# Get from: https://developers.facebook.com/apps/ > WhatsApp > Getting Started
WHATSAPP_API_TOKEN=your-whatsapp-business-api-token
WHATSAPP_PHONE_ID=your-phone-number-id
# Optional: template namespace for pre-approved message templates
WHATSAPP_TEMPLATE_NS=

# Rate limiting (Supabase-backed — adjust thresholds as needed)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_WINDOW=60
